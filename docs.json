  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://oddswire.io"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://oddswire.io"
      },
      {
        "label": "Support",
        "href": "mailto:spazman2c@gmail.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Workspace",
      "href": "https://oddswire.io/app"
    }
  },
  "footer": {
    "links": [
