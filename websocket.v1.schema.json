{
  "$id": "https://docs.oddswire.io/websocket.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BrowserWSAuthentication": {
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "maxLength": 256,
          "minLength": 32,
          "type": "string"
        },
        "type": {
          "enum": [
            "authenticate"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "ticket"
      ],
      "type": "object"
    },
    "WSCommand": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "type": {
          "enum": [
            "subscribe",
            "unsubscribe",
            "ping"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "WSFrame": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/WSChange"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "connection_limit": {
          "type": "integer"
        },
        "cursor": {
          "type": "string"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "type": "array"
        },
        "dataset_data": {
          "items": {
            "$ref": "#/$defs/DatasetOdds"
          },
          "type": "array"
        },
        "delivery_mode": {
          "enum": [
            "transactional",
            "snapshot_only"
          ],
          "type": "string"
        },
        "delivery_seq": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/Missing"
          },
          "type": "array"
        },
        "namespace": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "replace": {
          "type": "boolean"
        },
        "resume_seconds": {
          "type": "integer"
        },
        "sent_ts": {
          "format": "date-time",
          "type": "string"
        },
        "snapshot_ts": {
          "format": "date-time",
          "type": "string"
        },
        "subscription_limit": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "hello",
            "dataset_snapshot",
            "snapshot",
            "delta",
            "state",
            "resumed",
            "unsubscribed",
            "pong",
            "heartbeat",
            "error",
            "resnapshot_required"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "delivery_seq",
        "sent_ts",
        "data",
        "changes",
        "missing",
        "replace"
      ],
      "type": "object"
    },
    "WSChange": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "removes": {
          "items": {
            "$ref": "#/$defs/WSRemoval"
          },
          "type": "array"
        },
        "upserts": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "position",
        "upserts",
        "removes"
      ],
      "type": "object"
    },
    "WSRemoval": {
      "additionalProperties": false,
      "properties": {
        "quote_key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "quote_key",
        "reason"
      ],
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "type": "number"
        },
        "delivery": {
          "$ref": "#/$defs/PriceDelivery"
        },
        "display_format": {
          "enum": [
            "decimal",
            "american"
          ],
          "type": "string"
        },
        "display_odds": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_id": {
          "$ref": "#/$defs/ID"
        },
        "fixture_phase": {
          "enum": [
            "scheduled",
            "live",
            "ended",
            "cancelled"
          ],
          "type": "string"
        },
        "freshness_limit_seconds": {
          "type": "integer"
        },
        "identity_scope": {
          "enum": [
            "reviewed_group",
            "source_local"
          ],
          "type": "string"
        },
        "inplay": {
          "$ref": "#/$defs/InPlayCoverage"
        },
        "mapping_revision": {
          "type": "integer"
        },
        "mapping_swapped": {
          "type": "boolean"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "quote_key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_swapped": {
          "type": "boolean"
        },
        "source_ts": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "active",
            "stale",
            "suspended",
            "unavailable"
          ],
          "type": "string"
        },
        "target_code": {
          "type": "string"
        },
        "target_line_quarters": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "$ref": "#/$defs/Terms"
        }
      },
      "required": [
        "fixture_phase",
        "quote_key",
        "fixture_id",
        "identity_scope",
        "market",
        "outcome",
        "target_code",
        "target_line_quarters",
        "mapping_revision",
        "source_swapped",
        "mapping_swapped",
        "delivery",
        "source_ts",
        "status",
        "age_seconds",
        "freshness_limit_seconds",
        "display_format",
        "display_odds",
        "terms"
      ],
      "type": "object"
    },
    "PriceDelivery": {
      "additionalProperties": false,
      "properties": {
        "price": {
          "$ref": "#/$defs/LatestPrice"
        },
        "sent_ts": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "price",
        "sent_ts"
      ],
      "type": "object"
    },
    "LatestPrice": {
      "additionalProperties": false,
      "properties": {
        "confirmed_ts": {
          "format": "date-time",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/PriceObservation"
        }
      },
      "required": [
        "observation",
        "confirmed_ts"
      ],
      "type": "object"
    },
    "PriceObservation": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/PriceKey"
        },
        "raw_payload_id": {
          "format": "uuid",
          "type": "string"
        },
        "seen_ts": {
          "format": "date-time",
          "type": "string"
        },
        "source_sequence": {
          "type": "string"
        },
        "source_ts": {
          "format": "date-time",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PriceValue"
        }
      },
      "required": [
        "event_id",
        "raw_payload_id",
        "key",
        "value",
        "seen_ts"
      ],
      "type": "object"
    },
    "PriceKey": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "maximum": 3,
          "type": "integer"
        },
        "fixture_id": {
          "$ref": "#/$defs/ID"
        },
        "market_id": {
          "$ref": "#/$defs/ID"
        },
        "outcome_id": {
          "$ref": "#/$defs/ID"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "source_fixture_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/ID"
        },
        "source_market_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_outcome_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "fixture_id",
        "market_id",
        "outcome_id",
        "source_fixture_id",
        "source_market_id",
        "source_outcome_id",
        "side",
        "depth"
      ],
      "type": "object"
    },
    "ID": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "Side": {
      "enum": [
        "quote",
        "back",
        "lay",
        "bid",
        "ask"
      ],
      "type": "string"
    },
    "PriceValue": {
      "additionalProperties": false,
      "properties": {
        "available_size": {
          "$ref": "#/$defs/Decimal"
        },
        "commission_rate": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "decimal_odds": {
          "$ref": "#/$defs/Decimal"
        },
        "fee_rate": {
          "$ref": "#/$defs/Decimal"
        },
        "main_line": {
          "type": "boolean"
        },
        "native_unit": {
          "$ref": "#/$defs/NativeUnit"
        },
        "native_value": {
          "$ref": "#/$defs/Decimal"
        },
        "size_unit": {
          "enum": [
            "currency",
            "contracts"
          ],
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PriceState"
        }
      },
      "required": [
        "state",
        "native_unit"
      ],
      "type": "object"
    },
    "Decimal": {
      "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{8}$",
      "type": "string"
    },
    "NativeUnit": {
      "enum": [
        "decimal_odds",
        "probability"
      ],
      "type": "string"
    },
    "PriceState": {
      "enum": [
        "active",
        "suspended",
        "unavailable"
      ],
      "type": "string"
    },
    "InPlayCoverage": {
      "additionalProperties": false,
      "properties": {
        "families": {
          "items": {
            "$ref": "#/$defs/Family"
          },
          "type": "array"
        },
        "freshness_limit_seconds": {
          "type": "integer"
        },
        "mode": {
          "enum": [
            "pre_match_only",
            "local_test_only"
          ],
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "families",
        "freshness_limit_seconds",
        "reason"
      ],
      "type": "object"
    },
    "Family": {
      "enum": [
        "1x2",
        "total",
        "asian_handicap"
      ],
      "type": "string"
    },
    "Market": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/Family"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "line_quarters": {
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "participant_id": {
          "$ref": "#/$defs/ID"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "settlement_rule": {
          "minLength": 1,
          "type": "string"
        },
        "sport_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "id",
        "sport_id",
        "family",
        "period",
        "settlement_rule",
        "name"
      ],
      "type": "object"
    },
    "Period": {
      "enum": [
        "full_time",
        "first_half"
      ],
      "type": "string"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "home",
            "draw",
            "away",
            "over",
            "under"
          ],
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "market_id": {
          "$ref": "#/$defs/ID"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "market_id",
        "code",
        "name"
      ],
      "type": "object"
    },
    "Terms": {
      "additionalProperties": false,
      "properties": {
        "fee_model": {
          "enum": [
            "sportsbook_gross",
            "native_schedule_unreviewed",
            "unknown"
          ],
          "type": "string"
        },
        "fee_schedule": {
          "type": "object"
        },
        "fees_enabled": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rules_sha256": {
          "type": "string"
        }
      },
      "required": [
        "fee_model",
        "fees_enabled",
        "fee_schedule"
      ],
      "type": "object"
    },
    "DatasetOdds": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/DatasetEvidence"
        },
        "fixture_id": {
          "type": "string"
        },
        "identity_scope": {
          "type": "string"
        },
        "line": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_unit": {
          "type": "string"
        },
        "market_class": {
          "type": "string"
        },
        "market_id": {
          "type": "string"
        },
        "market_name": {
          "type": "string"
        },
        "original": {
          "type": "object"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/DatasetParticipant"
          },
          "type": "array"
        },
        "period": {
          "type": "string"
        },
        "player_identity_verified": {
          "type": "boolean"
        },
        "selection_id": {
          "type": "string"
        },
        "selection_name": {
          "type": "string"
        },
        "settlement_compatibility_verified": {
          "type": "boolean"
        },
        "side": {
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/ID"
        },
        "state": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "line",
        "line_unit",
        "side",
        "fixture_id",
        "identity_scope",
        "source_id",
        "market_id",
        "selection_id",
        "market_name",
        "selection_name",
        "market_class",
        "period",
        "unit",
        "value",
        "state",
        "participants",
        "player_identity_verified",
        "settlement_compatibility_verified",
        "evidence",
        "original"
      ],
      "type": "object"
    },
    "DatasetEvidence": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "type": "string"
        },
        "confirmed_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "delay_seconds": {
          "type": "integer"
        },
        "fresh_for_live_use": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "received_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "delay_seconds",
        "mode",
        "received_at",
        "confirmed_at",
        "source_at",
        "fresh_for_live_use"
      ],
      "type": "object"
    },
    "DatasetParticipant": {
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "type": "string"
        },
        "id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_scope": {
          "type": "string"
        },
        "identity_verified": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "team",
            "player"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "original": {
          "type": "object"
        },
        "role": {
          "type": "string"
        },
        "source_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "role",
        "identity_scope",
        "source_id",
        "fixture_id",
        "identity_verified",
        "original"
      ],
      "type": "object"
    },
    "Missing": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "fixture_id": {
          "$ref": "#/$defs/ID"
        },
        "quote_key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "reason",
        "detail"
      ],
      "type": "object"
    }
  }
}
