{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Oddswire",
  "colors": {
    "primary": "#a3e635",
    "light": "#4d7c0f",
    "dark": "#bef264"
  },
  "appearance": {
    "default": "dark"
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "none",
      "proxy": false
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start building",
